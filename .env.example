GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Provider: auto (cascades Groq -> Gemini), groq, gemini, nvidia, or ollama
LLM_PROVIDER=auto

# Gemini Settings (Secondary Fallback)
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA NIM (OpenAI-compatible). Set LLM_PROVIDER=nvidia to use it.
NVIDIA_API_KEY=replace-with-your-nvidia-nim-key
NVIDIA_LLAMA_33_70B_API_KEY=replace-with-your-nvidia-nim-key
NVIDIA_NEMOTRON_49B_API_KEY=replace-with-your-nvidia-nim-key
NVIDIA_NEMOTRON_120B_API_KEY=replace-with-your-nvidia-nim-key
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

ANALYTICS_DB_PATH=runtime/analytics.db
TRACE_JSONL_PATH=runtime/traces.jsonl
LOG_LEVEL=INFO
